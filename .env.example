# Przykładowe zmienne środowiskowe dla aplikacji Stal (mock sklepu ze stalą).
#
# UWAGA: aplikacja NIE wczytuje tego pliku automatycznie (nie używa
# python-dotenv). Wartości są odczytywane wyłącznie z os.environ — ten plik to
# wyłącznie dokumentacja. Aby skorzystać z podanych ustawień, ustaw je
# w środowisku przed uruchomieniem, np.:
#
#   Linux / macOS (bash):
#     export HOST=0.0.0.0 PORT=8080 SECRET_KEY=zmien-mnie FLASK_DEBUG=0
#
#   Windows (cmd):
#     set HOST=0.0.0.0 && set PORT=8080 && set SECRET_KEY=zmien-mnie && set FLASK_DEBUG=0
#
#   Windows (PowerShell):
#     $env:HOST="0.0.0.0"; $env:PORT="8080"; $env:SECRET_KEY="zmien-mnie"; $env:FLASK_DEBUG="0"
#
# Bez ustawiania czegokolwiek aplikacja działa na poniższych domyślnych
# wartościach (zdefiniowanych w stal/config.py).
HOST=127.0.0.1
PORT=5000
SECRET_KEY=zmien-mnie-na-losowy-klucz
FLASK_DEBUG=0
